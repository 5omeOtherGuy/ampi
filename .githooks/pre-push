#!/usr/bin/env bash
# pre-push: `main` changes only through a squash-merged PR, and nothing is
# pushed without a green gate.
#
# - Refuses any push of the local `main` or to the remote `main`.
# - For every other branch push, runs `npm run gate` on the working tree
#   and refuses the push if it fails. Branch deletions and tag-only pushes
#   skip the gate.
#
# Only the owner may bypass this hook.

set -eu

RUN_GATE=0
# Push spec on stdin: `<local-ref> <local-sha> <remote-ref> <remote-sha>` per line.
while read -r LOCAL_REF LOCAL_SHA REMOTE_REF _REMOTE_SHA; do
  if [ "$LOCAL_REF" = "refs/heads/main" ] || [ "$REMOTE_REF" = "refs/heads/main" ]; then
    cat >&2 <<'MSG'
pre-push: refusing to push 'main'. main changes only through a squash-merged PR.

  Push a branch and open a PR instead (AGENTS.md "Landing a change"):
      git push -u origin <type>/<slug>
MSG
    exit 1
  fi
  case "$REMOTE_REF" in
    refs/heads/*)
      case "$LOCAL_SHA" in
        *[!0]*) RUN_GATE=1 ;;  # not an all-zero SHA, so not a deletion
      esac
      ;;
  esac
done

[ "$RUN_GATE" = "1" ] || exit 0

REPO_TOP=$(git rev-parse --show-toplevel)
# Pushing from a linked worktree exports an absolute GIT_DIR to this hook
# (and `git -c` exports GIT_CONFIG_PARAMETERS). Unset them so tests that
# create scratch repositories cannot write to this one.
if ! (unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_PREFIX GIT_COMMON_DIR GIT_CONFIG_PARAMETERS; cd "$REPO_TOP" && npm run --silent gate); then
  echo "pre-push: npm run gate failed; push refused." >&2
  exit 1
fi
