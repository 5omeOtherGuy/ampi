{
  "leader": "ctrl+b",
  "ampi.changelog": null, // Show what changed in recent ampi releases
  "ampi.config": null, // Pick the models for modes and subagents, or set up ampi-web
  "ampi.help": "f1", // List every key and command with the key it is bound to
  "ampi.keymapJson": null, // Show the keymap in effect as JSONC, to copy into your settings
  "ampi.palette": "ctrl+o", // Open the command palette
  "ampi.quit": "ctrl+c ctrl+c", // Quit
  "ampi.showVersion": "ctrl+o", // Show the ampi and Pi versions
  "ampi.status": null, // Show the current mode, model and tools, as /ampi-status does
  "mcp.authenticate": null, // Open Pi's MCP manager (/mcp) to sign in to a server
  "mcp.info": null, // Show the MCP servers Pi is set up with and the tools each one offers
  "mode.toggle": "ctrl+s", // Show the mode dial; each further press turns it to the next mode
  "mode.use.free": null, // Switch to the free mode
  "mode.use.high": null, // Switch to the high mode
  "mode.use.low": null, // Switch to the low mode
  "mode.use.medium": null, // Switch to the medium mode
  "mode.use.ultra": null, // Switch to the ultra mode
  "plugins.list": null, // List the loaded extensions with the commands and tools each registers
  "plugins.reload": null, // Reload extensions, skills, prompt templates and themes, as /reload does
  "prompt.clear": null, // Empty the prompt
  "prompt.copySelection": null, // Copy the transcript text selected with the mouse
  "prompt.dequeue": null, // Take everything that waits to run back into the prompt
  "prompt.history": "ctrl+r", // Pick a prompt you sent before and put it into the prompt
  "prompt.moveToLineEnd": null, // Move the cursor to the end of its line in the prompt
  "prompt.moveToLineStart": null, // Move the cursor to the start of its line in the prompt
  "prompt.openInEditor": "ctrl+g", // Edit the prompt in your external editor
  "prompt.openPalette": "/", // Open the command palette when / is typed into an empty prompt
  "prompt.queue": null, // Run the prompt as a follow-up message after the current turn instead of steering it
  "prompt.steerQueuedMessage": null, // Send the next waiting follow-up now, to steer the running turn
  "prompt.toggleHelp": "?", // Show or hide the shortcuts help in the prompt box
  "skills.list": null, // List the skills Pi loaded, grouped by where it found them
  "speed.toggleFast": "alt+r", // Turn fast speed on or off: priority serving from the provider, at a higher price
  "thread.analyzeContext": null, // Show what fills the context window: prompt, tools, AGENTS.md files, skills and messages
  "thread.archive": "ctrl+c ctrl+n", // Archive and start a new session
  "thread.archiveAndQuit": "ctrl+c ctrl+e", // Archive and quit
  "thread.copyMarkdown": null, // Copy this session to the clipboard as Markdown
  "thread.copyURL": null, // Copy the shell command that continues this session (ampi threads continue <id>)
  "thread.editSelectedMessage": "e", // Put the selected message into the prompt and continue the thread from before it, on a new branch
  "thread.interrupt": "esc esc", // Stop the running turn
  "thread.mention": null, // Pick a session and insert a reference to it (@<session id>) at the cursor
  "thread.new": "<leader>n", // Start a new session, as /new does
  "thread.rename": null, // Give this session a new title
  "thread.scrollToBottom": "end", // Jump to the end of the transcript and follow new output
  "thread.scrollToTop": "home", // Jump to the start of the transcript
  "thread.selectNextMessage": "tab", // Select the next user message; past the newest, clear the selection
  "thread.selectPreviousMessage": "shift+tab", // Select the previous user message of the thread; e then edits it
  "thread.showCost": null, // Show what this session cost so far, per model
  "thread.switch": ["ctrl+t", "<leader>t"], // Pick another session and switch to it
  "thread.switchToNext": null, // Go forward again after switching to the previous session
  "thread.switchToPrevious": null, // Go back to the session you switched away from
  "thread.toggleDetails": null, // Expand or collapse tool output and thinking together
  "thread.toggleOutline": null, // Show or hide the headings of the last response, next to the prompt
  "thread.unarchive": null // Take this session out of the archive
}
